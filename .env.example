# Bowling-HQ Environment Variables
# Copy this file to .env and adjust values as needed.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=bowlinghq
POSTGRES_DB=bowling_hq

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=******postgres:5432/bowling_hq
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Bowling-HQ