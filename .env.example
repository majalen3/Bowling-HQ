# Application
APP_NAME=Bowling-HQ
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# Database - PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=bowling_hq
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Database - MongoDB
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=bowling_hq

# Database - Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Bowling-HQ

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Features (toggle for phase progression)
ENABLE_COMMANDER_AI=True
ENABLE_GHOST_BOWLER=True
ENABLE_SESSIONS=False
ENABLE_VIDEO_COACH=False
ENABLE_DIGITAL_TWIN=False